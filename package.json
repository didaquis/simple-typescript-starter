{
  "name": "typescript-starter",
  "version": "4.0.0",
  "description": "A basic TypeScript app starter",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": "22.18.x"
  },
  "scripts": {
    "build": "rimraf ./build && tsc",
    "purge": "rimraf ./build && rimraf ./coverage && rimraf ./node_modules",
    "dev": "npm-run-all --parallel dev:server prettier-watch",
    "dev:server": "tsx watch src/index.ts",
    "start": "npm run build && node build/index.js",
    "lint": "eslint .",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' 'tests/**/*.ts' --write",
    "prettier-watch": "onchange 'src/**/*.ts' 'tests/**/*.ts' -- prettier --write {{changed}}",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.17.2",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "9.1.7",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "onchange": "^7.1.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  }
}
