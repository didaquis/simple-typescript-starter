{
  "name": "typescript-starter",
  "version": "3.1.0",
  "description": "A basic TypeScript app starter",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": "22.18.x"
  },
  "scripts": {
    "build": "rimraf ./build && tsc",
    "purgue": "rimraf ./build && rimraf ./coverage && rimraf ./node_modules",
    "dev": "npm-run-all --parallel dev:server prettier-watch",
    "dev:server": "tsx watch src/index.ts",
    "start": "npm run build && node build/index.js",
    "lint": "eslint . --ext .ts",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' 'tests/**/*.ts' --write",
    "prettier-watch": "onchange 'src/**/*.ts' 'tests/**/*.ts' -- prettier --write {{changed}}",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@didaquis/eslint-plugin-no-lenght": "^1.1.2",
    "@types/node": "^22.17.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "9.1.7",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^4.4.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.4"
  }
}
